# Tejas local configuration. Copy to .env and keep .env out of version control.
BROKER=simulated
DRY_RUN=true
BANKROLL=100000
SCAN_INTERVAL_SECONDS=30
IGNORE_MARKET_HOURS=false
MAX_HEARTBEAT_AGE_SECONDS=180

# Live orders require every item below, plus valid broker credentials. Keep these
# defaults disabled. The dashboard asks for the live acknowledgement on each
# manual live start and never persists it.
# ENABLE_LIVE_TRADING=false
# LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_TRADING
# Auto-start stays simulated/dry-run unless separately and deliberately enabled.
# ENABLE_LIVE_AUTOSTART=false
# LIVE_AUTOSTART_ACK=I_UNDERSTAND_LIVE_AUTOSTART
# USE_EARNINGS_GATE=true
# USE_SENTIMENT_GATE=true
# USE_FUNDAMENTALS_GATE=true
# SENTIMENT_SCAN_BUDGET_SECONDS=45
# EARNINGS_SCAN_BUDGET_SECONDS=30
# FUNDAMENTALS_SCAN_BUDGET_SECONDS=30

# Optional notifications (never commit real values).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard is loopback-only by default. For a deliberate LAN bind, set both
# values and use HTTPS/reverse-proxy protection as appropriate.
# TEJAS_UI_HOST=0.0.0.0
# TEJAS_UI_TOKEN=replace-with-a-long-random-token
