# Tejas local configuration. Copy to .env and keep .env out of version control.
BROKER=simulated
DRY_RUN=true
BANKROLL=100000
SCAN_INTERVAL_SECONDS=30
IGNORE_MARKET_HOURS=false

# Optional notifications (never commit real values).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard is loopback-only by default. For a deliberate LAN bind, set both
# values and use HTTPS/reverse-proxy protection as appropriate.
# TEJAS_UI_HOST=0.0.0.0
# TEJAS_UI_TOKEN=replace-with-a-long-random-token
